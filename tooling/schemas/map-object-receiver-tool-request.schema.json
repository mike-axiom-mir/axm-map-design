{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.invalid/schemas/map-object-receiver-tool-request.v0.1.json",
  "title": "AXM Map Object receiver tool request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_id",
    "sample_index",
    "service_frame",
    "static_batching"
  ],
  "properties": {
    "schema": {
      "const": "axm.map-object-receiver-tool-request/v0.1"
    },
    "tool_id": {
      "const": "axm.map.object.receiver.packet"
    },
    "sample_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "service_frame": {
      "enum": [
        "historical",
        "successor_20mm"
      ]
    },
    "static_batching": {
      "enum": [
        "none",
        "current_sequence_static_24"
      ]
    }
  }
}
